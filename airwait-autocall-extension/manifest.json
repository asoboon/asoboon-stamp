{
  "manifest_version": 3,
  "name": "ASOBooN AirWAIT AUTO Operator",
  "version": "17.0.0",
  "description": "ASOBooNのAirWAIT管理画面でテスト枠0042の通常呼出を自動運転します。外部DBは使用しません。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://airwait.jp/*",
    "https://*.airwait.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://airwait.jp/*",
        "https://*.airwait.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ASOBooN AirWAIT AUTO"
  }
}
